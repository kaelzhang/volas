    H8: ClassVar[TimeFrame]
    H12: ClassVar[TimeFrame]
    D1: ClassVar[TimeFrame]
    D3: ClassVar[TimeFrame]
    W1: ClassVar[TimeFrame]
    M1: ClassVar[TimeFrame]
    Y1: ClassVar[TimeFrame]
    def __str__(self) -> str: ...
