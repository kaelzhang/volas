{
  "name": "volas",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {
      "profile": "minimal"
    }
  },
  "postCreateCommand": "python -m pip install -U pip maturin pytest numpy && python -m pip install -e . && python examples/00_install_check.py",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "rust-lang.rust-analyzer"
      ]
    }
  }
}
